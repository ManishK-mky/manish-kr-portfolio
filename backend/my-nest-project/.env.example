# ─── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Number of reverse-proxy hops in front of the API (for rate-limit client IPs).
TRUST_PROXY=1
# Set to false to hide Swagger UI (/api/docs) in production.
SWAGGER_ENABLED=true

# ─── Database (MongoDB Atlas or local MongoDB) ───────────────────────────
# Atlas: mongodb+srv://<user>:<password>@<cluster-host>/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# ─── Auth ────────────────────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Allowed browser origin(s), comma-separated, no trailing slash.
FRONTEND_URL=http://localhost:3000
# lax when the frontend proxies /api/v1 (recommended); none if the browser calls
# the API on a different site directly (requires HTTPS).
COOKIE_SAMESITE=lax
# Optional, e.g. .example.com when API and site share a parent domain.
COOKIE_DOMAIN=

# ─── Cloudinary (https://console.cloudinary.com → Settings → API Keys) ────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Frontend cache revalidation ─────────────────────────────────────────
# The API calls this after content changes so pages update immediately.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Must match REVALIDATE_SECRET in the frontend environment.
REVALIDATE_SECRET=replace-with-a-shared-random-string

# ─── Contact form email notifications (optional, via Resend) ─────────────
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL=

# ─── Initial admin (read only by `npm run seed` / `npm run seed:admin`) ───
# Use a unique passphrase of 12+ characters. Remove these after seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ─── NestJS Observe (optional; `npx @nestjs/observe link`) ───────────────
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
