# Only NEXT_PUBLIC_* values reach the browser. Never put secrets in them.

# Public URL of this site (canonical links, sitemap, share links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API base URL used by the browser. Keep the default "/api/v1": requests go
# through this site's own origin and are proxied to the backend (see
# next.config.ts), so the auth cookie stays first-party.
NEXT_PUBLIC_API_URL=/api/v1

# ─── Server-only ─────────────────────────────────────────────────────────
# The backend's real address, used for server rendering and as the proxy target.
API_INTERNAL_URL=http://localhost:4000/api/v1

# Shared secret for the cache-revalidation webhook the API calls after edits.
# Must equal REVALIDATE_SECRET in the backend environment.
REVALIDATE_SECRET=replace-with-a-shared-random-string
